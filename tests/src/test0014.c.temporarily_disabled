#include "sute.h"

Return long_relative_path_test(void)
{
	INITTEST;

	m_create(char,pattern);

	// Create memory for the result
	m_create(char,result,MEMORY_STRING);
	m_create(char,chunk,MEMORY_STRING);

	ASSERT(SUCCESS == set_environment_variable("TESTING","true"));

	/*
	 * First test in the series. Database update with a new path
	 * specification and the --force parameter. The new path consists
	 * of a very long chain of nested subdirectories.
	 */
	const char *arguments = "--database=database1.db tests/fixtures/diffs/diff1";

	const char *filename = "templates/0014_001_1.txt";

	ASSERT(SUCCESS == runit(arguments,chunk,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == m_copy(result,chunk));

	arguments = "--update --force --database=database1.db tests/fixtures/long";

	ASSERT(SUCCESS == runit(arguments,chunk,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == m_concat_strings(result,chunk));

	const char *command = "cd ${TMPDIR} && "
	        "rm database1.db";

	ASSERT(SUCCESS == external_call(command,NULL,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == get_file_content(filename,pattern));
	ASSERT(SUCCESS == match_pattern(result,pattern,filename));

	// Clean to use it iteratively
	m_del(pattern);
	m_del(result);
	m_del(chunk);

	/*
	 * Second test in the series. First, create a file database with a very
	 * long subdirectory path. Then update this database using a new, short
	 * path and the --force option.
	 */
	arguments = "--database=database1.db tests/fixtures/long";

	filename = "templates/0014_001_2.txt";

	ASSERT(SUCCESS == runit(arguments,chunk,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == m_copy(result,chunk));

	arguments = "--update --force --database=database1.db "
	        "tests/fixtures/diffs/diff2";

	ASSERT(SUCCESS == runit(arguments,chunk,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == m_concat_strings(result,chunk));

	command = "cd ${TMPDIR} && "
	        "rm database1.db";

	ASSERT(SUCCESS == external_call(command,NULL,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == get_file_content(filename,pattern));
	ASSERT(SUCCESS == match_pattern(result,pattern,filename));

	// Clean to use it iteratively
	m_del(pattern);
	m_del(result);
	m_del(chunk);

	/*
	 * Third test in the series. Very long path as the
	 * primamary directory for recursive file traversal
	 */
	FILE *file = NULL;
	char *line = NULL;
	size_t len = 0;
	ssize_t read = 0;

	filename = "examples/the_last_of_longest_path";

	ASSERT(NULL != (file = fopen(filename,"r")));

	ASSERT(-1 != (read = getline(&line,&len,file)));

	if(file != NULL)
	{
		fclose(file);
	}

	if(read > 0)
	{
		line[read] = '\0';
	}

	ASSERT(SUCCESS == set_environment_variable("LONGEST_PATH",line));

	m_reset(&line);

	arguments = "--database=database1.db tests/fixtures/long/${LONGEST_PATH}";

	filename = "templates/0014_001_3.txt";

	ASSERT(SUCCESS == runit(arguments,result,NULL,COMPLETED,ALLOW_BOTH));

	command = "cd ${TMPDIR} && "
	        "rm database1.db";

	ASSERT(SUCCESS == external_call(command,NULL,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == get_file_content(filename,pattern));
	ASSERT(SUCCESS == match_pattern(result,pattern,filename));

	// Clean to use it iteratively
	m_del(pattern);
	m_del(result);

	/*
	 * Test #4 in the series. A very long relative path will
	 * be used to create the database file. SQLite has a significantly
	 * lower built-in path length limit compared to the operating system.
	 */
	file = NULL;
	line = NULL;
	len = 0;
	read = 0;

	filename = "examples/maximum_path_length_of_sqlite";

	ASSERT(NULL != (file = fopen(filename,"r")));

	ASSERT(-1 != (read = getline(&line,&len,file)));

	if(file != NULL)
	{
		fclose(file);
	}

	if(read > 0)
	{
		line[read] = '\0';
	}

	ASSERT(SUCCESS == set_environment_variable("LONG_PATH",line));

	m_reset(&line);

	arguments = "--database=tests/fixtures/long/${LONG_PATH}/database1.db "
	        "--ignore=\"^${LONG_PATH}/database1\\.db.*$\" "
	        "tests/fixtures/long";

	filename = "templates/0014_001_4.txt";

	ASSERT(SUCCESS == runit(arguments,result,NULL,COMPLETED,ALLOW_BOTH));

	command = "cd ${TMPDIR} && "
	        "rm tests/fixtures/long/${LONG_PATH}/database1.db";

	ASSERT(SUCCESS == external_call(command,NULL,NULL,COMPLETED,ALLOW_BOTH));
	ASSERT(SUCCESS == get_file_content(filename,pattern));
	ASSERT(SUCCESS == match_pattern(result,pattern,filename));

	// Clean to use it iteratively
	m_del(pattern);
	m_del(result);

	RETURN_STATUS;
}

