ARG BUILD=production
FROM archlinux:latest AS arch

ARG BUILD
ENV BUILD=${BUILD}

RUN set -eux; \
     pacman -Syu --noconfirm --needed base-devel gcc-libs llvm pcre2 upx; \
     pacman -Scc --noconfirm

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
RUN make ${BUILD}

CMD ["sh", "-c", "make tests"]
