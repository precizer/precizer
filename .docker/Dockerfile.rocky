ARG BUILD=production
FROM rockylinux:9 AS rocky

ARG BUILD
ENV BUILD=${BUILD}

RUN set -eux; \
    dnf -y update; \
    dnf -y install \
    gcc \
    make \
    llvm
    llvm-devel
    pcre2-devel
    upx;
  dnf -y clean all;
  rm -rf /var/cache/dnf

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
RUN make ${BUILD}

CMD ["sh", "-c", "make tests"]
