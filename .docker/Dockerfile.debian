FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS debian

RUN set -eux; \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gcc \
      clang \
      libclang-rt-dev \
      make \
      llvm \
      llvm-dev \
      libpcre2-dev \
      libsqlite3-dev \
      upx-ucl zip; \
    rm -rf /var/lib/apt/lists/*;

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests
RUN make -j ${BUILD}

CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
