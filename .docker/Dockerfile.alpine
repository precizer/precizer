FROM alpine@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS alpine

RUN set -eux; \
     apk add --no-cache build-base clang llvm compiler-rt pcre2-dev pcre2-static fts-dev sqlite-dev upx zip

WORKDIR /precizer

COPY . /precizer
RUN adduser -D builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ARG MAKE_ARGS=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests-debug
RUN make -j ${BUILD} ${MAKE_ARGS}

# musl doesn't have working sanitizer at all, that's why tests-debug is the default:
CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
