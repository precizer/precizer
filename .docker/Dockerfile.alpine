FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS alpine

RUN set -eux; \
     apk add --no-cache build-base clang llvm compiler-rt pcre2-dev pcre2-static fts-dev argp-standalone sqlite-dev upx

WORKDIR /precizer

COPY . /precizer
RUN adduser -D builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ARG MAKE_ARGS=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests-debug
RUN make -j ${BUILD} ${MAKE_ARGS}

# musl doesn't have working sanitizer at all, that's why tests-debug is the default:
CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
