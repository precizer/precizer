FROM alpine@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS alpine

RUN set -eux; \
     apk add --no-cache build-base clang llvm pcre2-dev pcre2-static fts-dev argp-standalone sqlite-dev upx cmocka cmocka-dev

WORKDIR /precizer

COPY . /precizer
RUN adduser -D builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests-debug
RUN make -j ${BUILD}

# musl doesn't have working sanitizer at all, that's why tests-debug is the default:
CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
