ARG BUILD=production
FROM alpine@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS alpine

ARG BUILD
ENV BUILD=${BUILD}

RUN set -eux; \
     apk add --no-cache build-base llvm pcre2-dev pcre2-static fts-dev argp-standalone sqlite-dev upx cmocka cmocka-dev

WORKDIR /precizer

COPY . /precizer
RUN adduser -D builder && chown -R builder:builder /precizer

USER builder
RUN make ${BUILD}

# musl doesn't have working sanitizer at all, that's why:
CMD ["sh", "-c", "make tests-debug"]
