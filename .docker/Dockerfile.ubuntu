FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS ubuntu

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      # lld-20 + llvm-20: LLVM linker and tools (llvm-ar, llvm-symbolizer)
      # required for clang-20 LTO builds and sanitizer stack traces
      gcc clang-20 lld-20 llvm-20 libclang-rt-20-dev make \
      libpcre2-dev \
      libsqlite3-dev \
      upx-ucl; \
    rm -rf /var/lib/apt/lists/*;

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ARG MAKE_ARGS=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests
RUN make -j ${BUILD} ${MAKE_ARGS}

CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
