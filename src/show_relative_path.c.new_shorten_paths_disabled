/**
 * @brief Formats metadata differences into a string based on the specified flag.
 *
 * This function appends formatted metadata (file size, creation time, or modification time)
 * to the provided string buffer using safe_asprintf_append. It is used to represent
 * differences between two sets of metadata.
 *
 * @param[out] string Pointer to a dynamically allocated string to which formatted metadata will be appended.
 * @param[in]  flag   Metadata type identifier:
 *                    - 0: File size
 *                    - 1: Creation time
 *                    - 2: Modification time
 * @param[in]  was    Pointer to the old metadata structure.
 * @param[in]  now    Pointer to the new metadata structure.
 *
 * @return Return enum indicating the function execution status.
 */
static Return metadata_to_string(
	char **string,
	int flag,
	const CmpctStat *was,
	const CmpctStat *now)
{
	Return status = SUCCESS;

	if(rational_logger_mode & (VERBOSE|TESTING))
	{
		switch(flag)
		{
			case 0:
				status = string_append(string,
							" was:%s, now:%s",
							bkbmbgbtbpbeb((size_t)was->st_size),
							bkbmbgbtbpbeb((size_t)now->st_size));
				break;

			case 1:
				status = string_append(string,
							" was:%s.%ld, now:%s.%ld",
							seconds_to_ISOdate(was->ctim_tv_sec),
							was->ctim_tv_nsec,
							seconds_to_ISOdate(now->ctim_tv_sec),
							now->ctim_tv_nsec);
				break;

			case 2:
				status = string_append(
							string,
							" was:%s.%ld, now:%s.%ld",
							seconds_to_ISOdate(was->mtim_tv_sec),
							was->mtim_tv_nsec,
							seconds_to_ISOdate(now->mtim_tv_sec),
							now->mtim_tv_nsec);
				break;

			default:
				break;
		}
	}

	provide(status);
}

/**
 * @brief Appends formatted text to a dynamically allocated string.
 *
 * If *dest is NULL, it behaves like asprintf().
 * Otherwise, it appends formatted text to the existing string.
 *
 * @param[out] dest Pointer to target string (must be freed by caller)
 * @param[in]  fmt  Format string
 * @param[in]  ...  Format arguments
 *
 * @return Return enum indicating success or failure
 */
static status Return string_append(
	char       **dest,
	const char *fmt,
	...)
{
	va_list args;
	va_start(args,fmt);

	char *new_part = NULL;
	int len = vasprintf(&new_part,fmt,args);

	va_end(args);

	if(len == -1 || new_part == NULL)
	{
		provide(FAILURE);
	}

	if(*dest == NULL)
	{

		*dest = new_part;

	} else {

		char *combined = NULL;

		len = asprintf(&combined,"%s%s",*dest,new_part);

		free(new_part);

		if(len == -1 || combined == NULL)
		{
			provide(FAILURE);
		}

		free(*dest);

		*dest = combined;
	}

	provide(SUCCESS);
}

/**
 * @brief Builds a string with combinations of change flags for a file.
 *
 * This function evaluates a bitmask of change flags and builds a string
 * (e.g., "size & ctime") along with their metadata differences. It also appends
 * whether the file will be rehashed.
 *
 * @param[flag_combination]   Pointer to resulting string (must be freed by caller)
 * @param      mega    Bitmask representing which file attributes have changed
 * @param      dbrow   Pointer to the saved DB row structure
 * @param      stat    Pointer to the new file stats
 * @param      rehash  Pointer to boolean indicating if rehashing is needed
 *
 * @return Return enum indicating success or failure
 */
static status Return get_flag_combinations(
	char            **flag_combination,
	int             mega,
	const DBrow     *dbrow,
	const CmpctStat *stat,
	const bool      *rehash)
{
	/// The status that will be passed to return() before exiting.
	/// By default, the function worked without errors.
	Return status = SUCCESS;

	const char *flags[] = {
		"size","ctime","mtime", NULL
	};

	const int flag_values[] = {
		SIZE_CHANGED,CREATION_TIME_CHANGED,MODIFICATION_TIME_CHANGED
	};

	char *string = NULL;

	unsigned char flags_found = 0;

	Return status = SUCCESS;

	/* Check each flag */
	for(int i = 0; flags[i] != NULL; i++)
	{
		if(mega & flag_values[i])
		{
			if(flags_found == 0)
			{
				status = string_append(&string," ");

				if(SUCCESS != status)
				{
					free(string);
					return(status);
				}
			}

			/* Add separator if not the first flag */
			if(flags_found > 0)
			{
				printf(" & ");
			}

			status = string_append(&string,"%s",flags[i]);

			if(SUCCESS != status)
			{
				free(string);
				return(status);
			}

			/* Append metadata difference */
			char *metadata_string = NULL

			status = metadata_to_string(&metadata_string,i,&dbrow->saved_stat,stat);

			if(SUCCESS != status)
			{
				free(string);
				free(metadata_string);
				return(status);
			}

			if(SUCCESS == status)
			{
				status = string_append(&string,"%s",metadata_string);

				free(metadata_string);

				if(SUCCESS != status)
				{
					free(string);
					return(status);
				}
			}
		}
	}

	/* Append rehash info */
	if(*rehash == true)
	{
		if(dbrow->saved_offset > 0)
		{
			status = string_append(&string," continue to rehash from %s",bkbmbgbtbpbeb((const size_t)dbrow->saved_offset);
			free(offset_str);

			if(SUCCESS != status)
			{
				free(string);
				return(status);
			}
		} else {
			status = string_append(&string," rehash");

			if(SUCCESS != status)
			{
				free(string);
				return(status);
			}
		}
	} else {
		status = string_append(&string," no rehash");

		if(SUCCESS != status)
		{
			free(string);
			return(status);
		}
	}

	*flag_combination = string;

	status SUCCESS;
}

